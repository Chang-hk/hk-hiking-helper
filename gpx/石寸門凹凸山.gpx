88049f7a9483c9b4ff2caa7d5eb92~mv2.jpeg/v1/fill/w_277,h_277,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/photo-output_heic.jpeg" alt="photo-output.heic" style="object-fit:cover" class="gRkIq0 sFiSiq" width="277" height="277"/></div></div><!--/$--><!--$--><div id="comp-ms9ja8rk" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-ms9ja8rk wixui-rich-text" data-testid="richTextElement"><h1 class="font_0 wixui-rich-text__text" style="font-size:14px;"><span style="font-size:14px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:normal;" class="wixui-rich-text__text"><span style="font-family:anton,sans-serif;" class="wixui-rich-text__text">​水晶相片證書獎座及電子證書</span></span></span></span></h1></div><!--/$--><!--$--><div id="comp-ms7ljlvk" class="W4V2qg comp-ms7ljlvk wixui-image"><div data-testid="linkElement" class="apPOZK"><img loading="lazy" sizes="277px" srcSet="https://static.wixstatic.com/media/482454_21fb084c85da4052aed48f011a3621ad~mv2.jpeg/v1/fill/w_277,h_277,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/photo-output_heic.jpeg 1x, https://static.wixstatic.com/media/482454_21fb084c85da4052aed48f011a3621ad~mv2.jpeg/v1/fill/w_554,h_554,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/photo-output_heic.jpeg 2x" id="img_comp-ms7ljlvk" src="https://static.wixstatic.com/media/482454_21fb084c85da4052aed48f011a3621ad~mv2.jpeg/v1/fill/w_277,h_277,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/photo-output_heic.jpeg" alt="photo-output.heic" style="object-fit:cover" class="gRkIq0 sFiSiq" width="277" height="277"/></div></div><!--/$--><!--$--><div id="comp-ms9jcwc8" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-ms9jcwc8 wixui-rich-text" data-testid="richTextElement"><h1 class="font_0 wixui-rich-text__text" style="font-size:14px;"><span style="font-size:14px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-weight:normal;" class="wixui-rich-text__text"><span style="font-family:anton,sans-serif;" class="wixui-rich-text__text">​水晶相片證書獎座及電子證書</span></span></span></span></h1></div><!--/$--><!--$--><div id="comp-mrmrlge04" class="W4V2qg comp-mrmrlge04 wixui-image"><div data-testid="linkElement" class="apPOZK"><img loading="lazy" sizes="277px" srcSet="https://static.wixstatic.com/media/482454_1671333f8fc14787be728efffbdd6ed9~mv2.jpeg/v1/fill/w_277,h_277,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/photo-output_heic.jpeg 1x, https://static.wixstatic.com/media/482454_1671333f8fc14787be728efffbdd6ed9~mv2.jpeg/v1/fill/w_554,h_554,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/photo-output_heic.jpeg 2x" id="img_comp-mrmrlge04" src="https://static.wixstatic.com/media/482454_1671333f8fc14787be728efffbdd6ed9~mv2.jpeg/v1/fill/w_277,h_277,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/photo-output_heic.jpeg" alt="photo-output.heic" style="object-fit:cover" class="gRkIq0 sFiSiq" width="277" height="277"/></div></div><!--/$--><!--$--><div id="comp-ms9jd5ft" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-ms9jd5ft wixui-rich-text" data-testid="richTextElement"><h1 class="font_0 wixui-rich-text__text" style="font-size:14px;">​紀念衛衣</h1></div><!--/$--></div></div></section><!--/$--><!--$--><section id="comp-mrmrlge3" tabindex="-1" class="Le88gL comp-mrmrlge3 wixui-section" data-block-level-container="ClassicSection"><div id="bgLayers_comp-mrmrlge3" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mrmrlge3" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mrmrlge3" data-motion-part="BG_MEDIA comp-mrmrlge3" class="ROWgFb"></div></div><div data-mesh-id="comp-mrmrlge3inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mrmrlge3inlineContent-gridContainer" data-testid="mesh-container-content"><!--$--><div id="comp-mrmrlge74" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mrmrlge74 wixui-rich-text" data-testid="richTextElement"><h1 class="font_0 wixui-rich-text__text" style="font-size:42px;"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-family:&quot;bai jamjuree&quot;, sans-serif; font-weight:700;" class="wixui-rich-text__text">選手包領取特別安排</span></span></h1></div><!--/$--><!--$--><div id="comp-mrmrlge54" class="W4V2qg comp-mrmrlge54 wixui-image"><div data-testid="linkElement" class="apPOZK"><img loading="lazy" sizes="277px" srcSet="https://static.wixstatic.com/media/482454_15fee72b0adb477f807c72c3ac9c7e46~mv2.jpeg/v1/fill/w_277,h_277,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/photo-output_heic.jpeg 1x, https://static.wixstatic.com/media/482454_15fee72b0adb477f807c72c3ac9c7e46~mv2.jpeg/v1/fill/w_554,h_554,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/photo-output_heic.jpeg 2x" id="img_comp-mrmrlge54" src="https://static.wixstatic.com/media/482454_15fee72b0adb477f807c72c3ac9c7e46~mv2.jpeg/v1/fill/w_277,h_277,al_c,q_80,usm_0.66_1.00_0.01,enc_avif,quality_auto/photo-output_heic.jpeg" alt="photo-output.heic" style="object-fit:cover" class="gRkIq0 sFiSiq" width="277" height="277"/></div></div><!--/$--><!--$--><div id="comp-mrmrlge43" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mrmrlge43 wixui-rich-text" data-testid="richTextElement"><h1 class="font_0 wixui-rich-text__text" style="font-size:30px;"><span style="font-size:30px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-family:bai jamjuree,sans-serif;" class="wixui-rich-text__text">​第一階段報名, 可選擇以順豐到付方面領取選手包, 為鼓勵參加者選用順豐到付方式領取, 除了會較現場領取更早領取選手包外, 更可額外多的一條百登4頭巾一條.<br class="wixui-rich-text__text">
&nbsp;</span></span></span><span style="color:#E01A1A;" class="wixui-rich-text__text"><span style="font-size:14px;" class="wixui-rich-text__text">第二及第三階段, 及期後更改, 將無額外頭巾安排, 敬請注意.</span></span><br class="wixui-rich-text__text">
<br class="wixui-rich-text__text">
<span style="font-size:30px;" class="wixui-rich-text__text"><span style="color:#E01A1A;" class="wixui-rich-text__text"><span style="font-family:bai jamjuree,sans-serif;" class="wixui-rich-text__text">​單一參加者報名連加購滿$1,000 ,<br class="wixui-rich-text__text">
可獲香港地區智能櫃免運費優惠</span></span></span><br class="wixui-rich-text__text">
<span style="font-size:14px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text">選擇以順豐智能櫃收取, 一般費用預計低於$20, 較前往到取交通費更加化算.</span></span></h1></div><!--/$--><!--$--><div id="comp-ms5pes39" class="comp-ms5pes39" data-semantic-classname="button"><a data-testid="linkElement" href="https://htm.sf-express.com/hk/tc/download/SF-Locker-Mailing-Service-Applicable-Locker-List_TC.pdf" target="_blank" rel="noreferrer noopener" class="StylableButton2545352419__root StylableButton2545352419__forcedColorsBackground style-ms9mal23__root wixui-button StylableButton2545352419__link" aria-label="順豐智能櫃位置清單"><span class="StylableButton2545352419__container"><span class="StylableButton2545352419__label wixui-button__label" data-testid="stylablebutton-label">順豐智能櫃位置清單</span><span class="StylableButton2545352419__icon wixui-button__icon" aria-hidden="true" data-testid="stylablebutton-icon"><span><svg data-bbox="13.05 2.55 33.878 54.8" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60">
    <g>
        <path d="M46.5 28.9L20.6 3c-.6-.6-1.6-.6-2.2 0l-4.8 4.8c-.6.6-.6 1.6 0 2.2l19.8 20-19.9 19.9c-.6.6-.6 1.6 0 2.2l4.8 4.8c.6.6 1.6.6 2.2 0l21-21 4.8-4.8c.8-.6.8-1.6.2-2.2z"></path>
    </g>
</svg>
</span></span></span></a></div><!--/$--></div></div></section><!--/$--><!--$--><section id="comp-ms5phpux" tabindex="-1" class="Le88gL comp-ms5phpux wixui-section" data-block-level-container="ClassicSection"><div id="bgLayers_comp-ms5phpux" data-hook="bgLayers" data-motion-part="BG_LAYER comp-ms5phpux" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-ms5phpux" data-motion-part="BG_MEDIA comp-ms5phpux" class="ROWgFb"></div></div><div data-mesh-id="comp-ms5phpuxinlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-ms5phpuxinlineContent-gridContainer" data-testid="mesh-container-content"><!--$--><div id="comp-ms5pj73e" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-ms5pj73e wixui-rich-text" data-testid="richTextElement"><h1 class="font_0 wixui-rich-text__text" style="font-size:42px;"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-family:bai jamjuree,sans-serif; font-weight:700;" class="wixui-rich-text__text"><span class="wixui-rich-text__text">​沙木尼登山用品 年度VIP</span></span></span></h1></div><!--/$--><!--$--><div id="comp-ms5pijqk" class="W4V2qg comp-ms5pijqk wixui-image cs40a3" title="photo-output.jpeg"><a data-testid="linkElement" href="https://www.chamonix.com.hk/" target="_blank" rel="noreferrer noopener" class="apPOZK"><img loading="lazy" sizes="267px" srcSet="https://static.wixstatic.com/media/482454_c43574ce791b41b38d8d12656a7e7360~mv2.png/v1/fill/w_267,h_267,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/photo-output%20(1)_heic.png 1x, https://static.wixstatic.com/media/482454_c43574ce791b41b38d8d12656a7e7360~mv2.png/v1/fill/w_534,h_534,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/photo-output%20(1)_heic.png 2x" id="img_comp-ms5pijqk" src="https://static.wixstatic.com/media/482454_c43574ce791b41b38d8d12656a7e7360~mv2.png/v1/fill/w_267,h_267,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/photo-output%20(1)_heic.png" alt="photo-output (1).heic" style="object-fit:cover" class="gRkIq0 sFiSiq" width="267" height="267"/></a></div><!--/$--><!--$--><div id="comp-ms5pokr9" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-ms5pokr9 wixui-rich-text" data-testid="richTextElement"><h1 class="font_0 wixui-rich-text__text" style="font-size:30px;"><span style="font-size:30px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-family:bai jamjuree,sans-serif;" class="wixui-rich-text__text"><span class="wixui-rich-text__text">憑香港百登4 號碼布, 可享沙木尼登山用品 VIP折扣優惠待遇.</span></span></span></span><br class="wixui-rich-text__text">
<br class="wixui-rich-text__text">
<span style="font-size:20px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-family:bai jamjuree,sans-serif;" class="wixui-rich-text__text">​有效期至2027年6月30日<br class="wixui-rich-text__text">
​只限門店使用, 最終使用權由沙木尼登山用品決定</span></span></span></h1></div><!--/$--></div></div></section><!--/$--><!--$--><section id="comp-ms5n94s4" tabindex="-1" class="Le88gL comp-ms5n94s4 wixui-section" data-block-level-container="ClassicSection"><div id="bgLayers_comp-ms5n94s4" data-hook="bgLayers" data-motion-part="BG_LAYER comp-ms5n94s4" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-ms5n94s4" data-motion-part="BG_MEDIA comp-ms5n94s4" class="ROWgFb"></div></div><div data-mesh-id="comp-ms5n94s4inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-ms5n94s4inlineContent-gridContainer" data-testid="mesh-container-content"><!--$--><div id="comp-ms5nceyb" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-ms5nceyb wixui-rich-text" data-testid="richTextElement"><h1 class="font_0 wixui-rich-text__text" style="font-size:30px;"><span style="font-size:30px;" class="wixui-rich-text__text"><span style="color:#301d10;" class="wixui-rich-text__text"><span style="font-style:normal;" class="wixui-rich-text__text"><span style="font-weight:normal;" class="wixui-rich-text__text"><span style="font-family:arial black,arial-w01-black,sans-serif;" class="wixui-rich-text__text">LIFE FEVER FUN CLUB</span></span></span></span></span></h1></div><!--/$--><!--$--><div id="comp-ms5n96yb" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-ms5n96yb wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:18px;"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:20px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text">每位參加者將會自動成為LIFE FEVER FUN CLUB會員<br class="wixui-rich-text__text">
會員將有以下優惠</span></span><br class="wixui-rich-text__text">
<span style="font-size:12px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text">(會籍有效期至2027年8月31日)</span></span><br class="wixui-rich-text__text">
<br class="wixui-rich-text__text">
<span style="font-size:20px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text">1) 優先參與LIFE FEVER 舉行活動<br class="wixui-rich-text__text">
&nbsp; </span></span></span><span style="font-size:16px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text">(包括約跑及行山WeDone活動)</span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:20px;"><span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:20px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text">2) 個別收費活動可以FUN CLUB優惠價參加.<br class="wixui-rich-text__text">
3) 可加與FUN CLUB籌組的2028年百登毅行隊<br class="wixui-rich-text__text">
&nbsp;</span></span><span style="font-size:16px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text"> </span></span></span><span style="font-size:16px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text">(參加者須自行支持毅行者的報名費及籌款)</span></span><br class="wixui-rich-text__text">
<span style="font-weight:bold;" class="wixui-rich-text__text"><span style="font-size:20px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text">4) 以優惠價購買團購產品</span></span><br class="wixui-rich-text__text">
5) 越野賽折扣優惠<br class="wixui-rich-text__text">
6) 優先參與海外登山體驗班活動<br class="wixui-rich-text__text">
<span style="font-size:14px;" class="wixui-rich-text__text"><span style="color:#000000;" class="wixui-rich-text__text">會籍有效期至2027年8月31日<br class="wixui-rich-text__text">
優先及活動與團購的折扣安排最終視乎個別活動性質.</span></span></span></p></div><!--/$--></div></div></section><!--/$--><!--$--><section id="comp-mrmrlge84" tabindex="-1" class="Le88gL comp-mrmrlge84 wixui-section" data-block-level-container="ClassicSection"><div id="bgLayers_comp-mrmrlge84" data-hook="bgLayers" data-motion-part="BG_LAYER comp-mrmrlge84" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-mrmrlge84" data-motion-part="BG_MEDIA comp-mrmrlge84" class="ROWgFb"></div></div><div data-mesh-id="comp-mrmrlge84inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-mrmrlge84inlineContent-gridContainer" data-testid="mesh-container-content"><!--$--><div id="comp-mrmrlgec" class="N8MGzv _v6ohL AWXfZq PO9MfV comp-mrmrlgec wixui-rich-text" data-testid="richTextElement"><h1 class="font_0 wixui-rich-text__text" style="font-size:36px;"><span style="color:#000000;" class="wixui-rich-text__text"><span style="font-size:36px;" class="wixui-rich-text__text"><span style="font-family:bai jamjuree,sans-serif;" class="wixui-rich-text__text">歷屆香港百登完成者名單</span></span></span></h1></div><!--/$--><!--$--><div id="comp-ms5luej9" class="comp-ms5luej9" data-semantic-classname="button"><button type="button" class="StylableButton2545352419__root StylableButton2545352419__forcedColorsBackground style-ms9ma502__root wixui-button" data-testid="buttonContent" aria-label="第三屆百登完成者(即將公佈) "><span class="StylableButton2545352419__container"><span class="StylableButton2545352419__label wixui-button__label" data-testid="stylablebutton-label">第三屆百登完成者(即將公佈) </span><span class="StylableButton2545352419__icon wixui-button__icon" aria-hidden="true" data-testid="stylablebutton-icon"><span><svg data-bbox="13.05 2.55 33.878 54.8" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 60">
