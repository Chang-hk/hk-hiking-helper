ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1091,"length":1,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1092,"length":9,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1101,"length":5,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1106,"length":5,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1111,"length":3,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1114,"length":9,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1123,"length":2,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"},{"startIndex":1125,"length":8,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293982463,"raisedBackground":4293982463,"additiveBackground":558206409,"textPrimary":4278788663,"textSecondary":4281554806,"invertedBackground":4279851408,"overlayBackground":3423150647},"darkThemeColorPalette":{"baseBackground":4278325276,"raisedBackground":4278788663,"additiveBackground":725978569,"textPrimary":4292931323,"textSecondary":4289251297,"invertedBackground":4286363107,"overlayBackground":3423150647},"colorSampledDescriptionBodyText":{"content":"花瓶頂⛰高CP值初級靚景路線［香港行山郊遊路線］4k拍攝｜免費位置追蹤APP增加行山安全性｜汲水門大橋靚景|大嶼山日落靚景|定海神針二流鎮流碑|花瓶石|花瓶灣(藍鯨灣)|草灣|大嶼山離島行山郊遊路線［Hong Kong Hiking Route］\n\n1:56 MyMapHK P5me 通知功能介紹\n\n行山裝好緊要🎒\n1.智能手錶⌚： Coros APEX4\n2.藍芽耳機: Shokz openswim pro\n3.行山鞋🥾：  Altra Olympus 6\n4.Cap帽 ：Buff\n5:Tee：TRACK\n6.太陽眼鏡：EKOI\n7.背囊：Columbia \n8:風褸： 香港百登\n\n路線： 五鼓嶺\n起點及終點： 青嶼幹線轉車站\n距離：約2.3km\n預計時間：2小時\n體能因人而異，時間僅供參考\n\n支持及贊助拍攝🎬💰\n一按即 PayMe！\nhttps://payme.hsbc/vincentliwl\n\n拍攝日期： 2026年4月\n\n⚠️⚠️⚠️\n路線分享:\nGPX File 連結已放在影片內, 可掃描QR Code下載\n(可能有部份手機瀏覽器及QC code掃描App未能直接下載, 如有此情況可複製連結,再在桌面電腦開啟. 複製連結至手機App Signal, Whatapp , Safari , Firefox 亦可開啟下載.  \n\n⚠️⚠️⚠️\n版權聲明：影片版權為CAPTAIN VL CHANNEL擁有, 未經受權不可取用影片\n\n⚠️⚠️⚠️\n免責聲明: 短片純粹個人意見分享， 絕非任何專業性指導， 亦不構成任何登山 建議, 短片純粹希望讓山友對路況多一點了解, 從而評估自己能力及經驗是否足夠應付.\n\n喜歡我既短片分享既, 記得訂閱我既頻道喇!, 同時選擇 \"全部\"通知 , 第一時間接到通知\nFACEBOOK: CAPTAIN VL CHANNEL \nIG: captainvl.vincent \n合作聯繫\nEMAIL: trailnrunman@gmail.com\n\n#香港行山\n#行山路線\n#花瓶頂\n#初級路線\n#hkhiking  \n#hkhiker \n#hike\n#hktrail \n#hktravel \n#hktraveller \n#captainvlchannel \n#captainvl\n#sporti\n#香港行山 \n#香港行山路線 \n#香港行山好去處 \n#香港真係好靚\n#香港行山 \n#outdoors #travel \n#hktravel \n#hongkongig\n#hongkongtravel\n#hongkongphoto\n#hongkong🇭🇰\n#山野無痕  \n#自己垃圾自己帶走 \n#難又拍吓易又吓","commandRuns":[{"startIndex":125,"length":4,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBsQ040EGAYiEwjS_uS076SYAxVamtYIHQheLd3KAQQuV8RY","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=PS6Kqe_x3Pk\u0026t=116s","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"PS6Kqe_x3Pk","continuePlayback":true,"startTimeSeconds":116,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr2---sn-hgn7yn7e.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026oehoh5=1\u0026epbp=1\u0026msp=1\u0026odepv=1\u0026id=3d2e8aa9eff1dcf9\u0026ip=104.28.215.68\u0026osts=116\u0026initcwndbps=1019250\u0026mt=1795669312\u0026oweuc=\u0026pxtags=Cg4KAnR4Egg1MTkyOTU2Nw\u0026rxtags=Cg4KAnR4Egg1MTkyOTU2Ng%2CCg4KAnR4Egg1MTkyOTU2Nw%2CCg4KAnR4Egg1MTkyOTU2OA"}}}}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"1 分鐘 56 秒"}}},{"startIndex":378,"length":30,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBsQ040EGAYiEwjS_uS076SYAxVamtYIHQheLd1I-bnH_57Vopc9ygEELlfEWA==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUlxb01IYVEyMVE4QWh3VmxPRVFSYU5yc043S3xBQnJ0NjluQXBWcVFsMVB6a0VrTGd0eTlleWZxUk5xUEFFU000cXFTLWw3Z2NRUzRZWHJKVDd0ckItbnl3M0JTU2NQdXZGTGFvcEVMaUhz