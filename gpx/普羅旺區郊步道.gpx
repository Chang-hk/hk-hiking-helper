annotations/youtube.png"}]},"left":0.82280701,"width":0.15438597,"top":0.54906541,"aspectRatio":1,"startMs":"1385723","endMs":"1390723","title":{"accessibility":{"accessibilityData":{"label":"Captain VL Channel隊長郊遊頻道，頻道"}},"simpleText":"Captain VL Channel隊長郊遊頻道"},"metadata":{"simpleText":"Captain VL Channel 隊長郊遊頻道\n\n一位志在參與既業餘長跑及越野賽運動員, \n每次講起行山跑步就異常雀躍.\n喜歡跟人分享行山跑步樂事.\n\n反正都係周圍四處走, \n又鐘意開心Share!\n\n於是決定開個YOU TUBE頻道, \n同大家分享一些行山跑步路線, \n以至一些比賽分享\n\n如果大家對行山郊遊, 長跑路線有興趣\n歡迎 訂閱我既You Tube頻道\n\nFACEBOOK: CAPTAIN VL CHANNEL \nIG: TRAILNRUNMAN \n🤝合作聯繫\nEMAIL: trailnrunman@gmail.com\n"},"callToAction":{"simpleText":"瀏覽頻道"},"dismiss":{"simpleText":"取消"},"endpoint":{"clickTrackingParams":"CAgQ-N4BGAAiEwiI7-S076SYAxV1mlYBHRf1Eh4yDGl2LWVuZHNjcmVlbkj5ucf_ntWilz3KAQQuV8RY","commandMetadata":{"webCommandMetadata":{"url":"/channel/UC-4pRjnTEVXuAS6_n7KROtg","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UC-4pRjnTEVXuAS6_n7KROtg"}},"hovercardButton":{"subscribeButtonRenderer":{"buttonText":{"runs":[{"text":"訂閱"}]},"subscribed":false,"enabled":true,"type":"FREE","channelId":"UC-4pRjnTEVXuAS6_n7KROtg","showPreferences":false,"subscribedButtonText":{"runs":[{"text":"已訂閱"}]},"unsubscribedButtonText":{"runs":[{"text":"訂閱"}]},"trackingParams":"CAkQmysiEwiI7-S076SYAxV1mlYBHRf1Eh4yDGl2LWVuZHNjcmVlbg==","unsubscribeButtonText":{"runs":[{"text":"取消訂閱"}]},"serviceEndpoints":[{"clickTrackingParams":"CAkQmysiEwiI7-S076SYAxV1mlYBHRf1Eh4yDGl2LWVuZHNjcmVlbsoBBC5XxFg=","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/subscription/subscribe"}},"subscribeEndpoint":{"channelIds":["UC-4pRjnTEVXuAS6_n7KROtg"],"params":"EgIIBBgAWAE%3D"}},{"clickTrackingParams":"CAkQmysiEwiI7-S076SYAxV1mlYBHRf1Eh7KAQQuV8RY","commandMetadata":{"webCommandMetadata":{"sendPost":true}},"signalServiceEndpoint":{"signal":"CLIENT_SIGNAL","actions":[{"clickTrackingParams":"CAkQmysiEwiI7-S076SYAxV1mlYBHRf1Eh7KAQQuV8RY","openPopupAction":{